{
  "name": "solidforge-pi",
  "version": "0.2.6",
  "description": "SolidForge — loop-engineering skills for the Pi coding agent: converge → specify → implement pipeline + outcome-axis verification layers. Pi port of the Claude Code plugin.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "pi": {
    "namespace": "solidforge",
    "image": "https://raw.githubusercontent.com/maskshell/solidforge-pi/master/docs/preview.png",
    "extensions": [
      "./extensions/sf-subagents",
      "./extensions/sf-hooks",
      "./extensions/sf-providers",
      "./extensions/sf-progress",
      "./extensions/sf-hetero"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "extensions",
    "skills",
    "agents",
    "prompts",
    "tools",
    "docs",
    "README.md",
    "PORTING-PLAN.md",
    "NOTICE",
    "!**/__pycache__",
    "!**/.ruff_cache",
    "!**/*.pyc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maskshell/solidforge-pi.git"
  },
  "bugs": {
    "url": "https://github.com/maskshell/solidforge-pi/issues"
  },
  "homepage": "https://github.com/maskshell/solidforge-pi#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
