# Solid Forge — heterogeneous-source (异源) adversarial-review secrets.
# COPY this file to `.env.solidforge` + fill in your tokens (or put the vars in your
# shell / the project `.env` — the wrapper reads all three; shell wins). ADR #40.
#
# This `.env.solidforge.example` is COMMITTED (no real tokens) — provisioned by
# `/solidforge:arm-tools`. The live `.env.solidforge` is gitignored (arm.py adds it).
#
# Provider selection for hetero_review.py (a NAME, or comma-list for dual-/multi-异源):
#   HETERO_PROFILE=deepseek            # default; or e.g. "deepseek,qwen-bailian" for dual-异源
#                                      # (CC-era names bigmodel/minimax/qwen3 still resolve via the wrapper alias map)
#
# Each provider's token. The var name is the CONVENTION
# <UPPERCASE-FILENAME>_ANTHROPIC_AUTH_TOKEN (matches profiles/<name>.json), so a
# user-added profiles/foo.json reads its token from FOO_ANTHROPIC_AUTH_TOKEN with no
# code change. Set ONLY the ones you use; override a name via the template's `_token_env`.
# Namespace isolation: the _ANTHROPIC_AUTH_TOKEN suffix is the SOLE token source — the
# provider's native <FILENAME>_API_KEY (e.g. DEEPSEEK_API_KEY) is NEVER read (it may
# serve another tool/SDK in the same env). Keep both if your project uses the native
# SDK too — they are separate credentials by design. See the namespace-isolation ADR.
HETERO_PROFILE=deepseek
# Per-subprocess wall-clock cap for hetero_review.py (seconds). Default 600; raise for a
# cold large-diff review on the pro tier. Do NOT remap the profile alias to dodge a
# timeout — cold-start is transient (DeepSeek auto-caches ~99% after the first call).
# ADR #43.
# HETERO_TIMEOUT=1200
# Run guards for hetero_review.py (ADR #52). --max-turns bounds the agentic loop
# (print-mode Claude Code has NO default turn limit); --max-stream-bytes is the
# runaway-stream breaker. Tripping the turn cap DEGRADES; tripping the byte cap
# MALFORMS loudly. While a subprocess runs, the wrapper heartbeats to stderr
# every 30s (elapsed / stream bytes / assistant events / the RESOLVED model).
# HETERO_MAX_TURNS=60
# HETERO_MAX_STREAM_BYTES=67108864
DEEPSEEK_ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-token
BIGMODEL_ANTHROPIC_AUTH_TOKEN=sk-your-bigmodel-token
# qwen: TWO credential channels — set the one your key belongs to.
QWEN_BAILIAN_ANTHROPIC_AUTH_TOKEN=sk-your-bailian-pay-per-use-key  # qwen-bailian route (DashScope pay-as-you-go)
QWEN_TOKEN_PLAN_CN_ANTHROPIC_AUTH_TOKEN=sk-your-token-plan-key       # qwen-token-plan-cn route (subscription)
MINIMAX_ANTHROPIC_AUTH_TOKEN=sk-your-minimax-token
